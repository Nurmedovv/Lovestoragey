<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogRootLayout"
    android:layout_width="380dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_effect_dialog"
    android:padding="20dp"
    android:gravity="center">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_font_color"
        android:textSize="22sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:id="@+id/colorDialogContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/glass_border_light"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:gravity="center">

        <GridLayout
            android:id="@+id/colorPresetGrid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="12"
            android:layout_gravity="center"
            android:useDefaultMargins="false"
            android:alignmentMode="alignBounds" />

    </LinearLayout>

    <TextView
        android:id="@+id/closeButton"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:text="❌"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
