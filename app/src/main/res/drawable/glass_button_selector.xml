<?xml version="1.0" encoding="utf-8"?>
<!-- 🎯 УНИВЕРСАЛЬНЫЙ СЕЛЕКТОР ДЛЯ ВСЕХ КНОПОК С ЭФФЕКТОМ ЖИДКОГО СТЕКЛА -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 🎯 СОСТОЯНИЕ ПРИ НАЖАТИИ - более прозрачный -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#60FFFFFF" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#80FFFFFF" />
        </shape>
    </item>

    <!-- 🎯 ОБЫЧНОЕ СОСТОЯНИЕ - стандартная прозрачность -->
    <item>
        <shape>
            <solid android:color="#40FFFFFF" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#80FFFFFF" />
        </shape>
    </item>

</selector>